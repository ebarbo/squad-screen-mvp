# Squad Screen MVP — server-side configuration.
#
# Copy to `.env.local` and fill in. Never commit a filled-in file.
# Nothing here may be prefixed NEXT_PUBLIC_: these values must not reach the browser bundle.
#
# Verify your configuration with:  npm run check:env
# Verify the provider actually answers with:  npm run demo:intelligence

# --- Required for live inference -------------------------------------------------
# Nebius Token Factory API key.
#
# This is the only value with no default: there is nothing safe to fall back to.
# Absent -> every generation returns a typed `missing_configuration` error. It never
# silently falls back to a canned response.
NEBIUS_API_KEY=

# --- Optional: defaults already applied in code ------------------------------------
# The values below are the defaults. They are identifiers rather than secrets, and both
# are confirmed reachable with the supplied API key, so leaving them unset is fine.
# Override only to test a different model.
#
# What that call did NOT establish: that the key is on the hackathon event account, or
# that an organiser approved these models. The API exposes no tenant identity endpoint,
# so the account question is unverifiable from here and is pending confirmation in the
# Nebius console. Do not describe these as "approved" or "event account" models until
# there is a record that says so.

# Primary model. The non-thinking Instruct variant is chosen deliberately: Apache-2.0
# open weights, instruction-tuned, and it returns the answer directly with no
# reasoning preamble to strip.
SQUAD_SCREEN_MODEL_ID=Qwen/Qwen3-235B-A22B-Instruct-2507

# Second model, used only by the controlled comparison (EWE-73). This one is
# a reasoning model: chain of thought goes to a separate `reasoning` field and leaves
# `content` clean, but it spends considerably more completion tokens for an equivalent
# answer. Token accounting therefore reads the provider's usage fields and never
# estimates from response length.
SQUAD_SCREEN_COMPARISON_MODEL_ID=openai/gpt-oss-120b

# OpenAI-compatible endpoint. api.studio.nebius.ai and api.tokenfactory.nebius.com
# are aliases of this same service.
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

# Transport selection: `live` (default) or `stub`.
# `stub` is a deterministic offline transport for tests, CI and offline development.
# It is opt-in only, and every response and telemetry record it produces is stamped
# `transport: "stub"` so it can never be mistaken for live inference.
SQUAD_SCREEN_MODEL_MODE=live

# Per-request timeout in milliseconds.
SQUAD_SCREEN_MODEL_TIMEOUT_MS=30000

# Maximum bounded repair retries for invalid structured output.
SQUAD_SCREEN_MODEL_MAX_RETRIES=2

# Pricing basis for the estimated inference cost, in USD per million tokens.
#
# This API exposes no pricing, usage or billing endpoint, so these can only be read
# from the Nebius console. Left unset, estimated cost is reported as null with that
# reason attached. A price is never inferred.
SQUAD_SCREEN_PRICE_INPUT_PER_MTOK=
SQUAD_SCREEN_PRICE_OUTPUT_PER_MTOK=

# Rate limits are not configured here: they are read live from the provider's
# response headers, because account quotas change and a stale constant is worse
# than no number.
